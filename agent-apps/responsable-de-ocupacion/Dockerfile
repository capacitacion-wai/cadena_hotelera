# Canonical Dockerfile for every wai-agent-app. COPIED VERBATIM by
# `wai-agent-app-builder` to the app root. Do NOT edit this file —
# the verifier (verify_generated_app.sh) blocks any byte change.
#
# Layout contract (must match assets/backend/app/main.py):
#   /app/                          — Python source (COPY src/backend → /app/)
#   /app/static/                   — React dist (COPY frontend-build /frontend/dist → /app/static)
#   /app/wai-app.json              — runtime manifest read by app.config
#   /app-data/app.sqlite           — local SQLite (mounted PVC, see deployer)
#
# Computing STATIC_DIR with Path(__file__).resolve().parents[N] is forbidden;
# the layout above is the only sanctioned source of truth.

# ─── frontend build ──────────────────────────────────────────────────
FROM node:20-slim AS frontend-build
WORKDIR /frontend
COPY src/frontend/package.json src/frontend/package-lock.json* ./
RUN npm install
COPY src/frontend ./
RUN npm run build

# ─── runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY src/backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/backend /app/
COPY --from=frontend-build /frontend/dist /app/static
COPY wai-app.json ./

# NOTE: a previous revision (P3-G1) introduced `USER 10001` for non-root
# hardening. That broke the SQLite open at lifespan startup because the
# PVC mounted at /app-data carries root ownership and the build-time
# chown is shadowed by the mount. The fix in K8s would be a `fsGroup:
# 10001` in the Pod spec (deployer-side change), not a Dockerfile-side
# chown. Until the deployer learns to set fsGroup, the container runs
# as root — same behaviour the platform has always had. The tenant
# isolation comes from NetworkPolicy + namespace RBAC, not the UID.
RUN mkdir -p /app-data

EXPOSE 8080

# G-1 (P3): container-level health probe. Returns 200 from the
# liveness endpoint (cheaper than /health which also pings the DB).
# K8s readinessProbe should still hit /health/ready (G-3).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request, sys; sys.exit(0) if urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=3).status==200 else sys.exit(1)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
